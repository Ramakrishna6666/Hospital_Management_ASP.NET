# .dockerignore for ASP.NET Framework Application
# Exclude build artifacts and unnecessary files

# Build outputs
bin/
obj/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]ld/

# Visual Studio files
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# NuGet packages (will be restored during build)
packages/
*.nupkg
*.snupkg

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Git files
.git/
.gitignore
.gitattributes

# Documentation
*.md
README*
CHANGELOG*
LICENSE*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE files
*.swp
*.swo
*~

# Deployment files
*.pubxml
*.publishproj

# Application Insights
ApplicationInsights.config

# Docker files
Dockerfile*
docker-compose*
.dockerignore

# Scripts
scripts/
*.sh
*.bat

# Documentation
docs/
*.md
